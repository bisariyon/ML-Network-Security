# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc

# Virtual environments
myenv/
env/
venv/
.venv/

# Secrets — NEVER bake into the image
.env

# Git history — not needed inside the container
.git/
.github/

# Raw training data — not needed for inference
Network_Data/
Artifacts/

# MLflow / experiment tracking (not used at inference time)
mlruns/
mlflow.db

# Logs and temp output
logs/
prediction_output/

# Dev / notebook files
*.ipynb
Trial.ipynb
.ipynb_checkpoints/

# Documentation and assets (not needed at runtime)
docs/
Architecture.pdf

# OS junk
.DS_Store
Thumbs.db

# Egg info (will be re-generated by pip install -e .)
*.egg-info/
NetworkSecurity.egg-info/
